      "id": "272caaf5-ad47-48af-8012-65591be9f999",
      "name": "Find checkout session",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        920,
        80
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const event = $('Stripe events').first().json;\nconst paymentIntent = event.data.object;\nconst session = $input.item.json.data?.[0];\nconst name = (session?.customer_details?.name ?? '').trim();\nconst firstName = name.split(/\\s+/)[0].replace(/[^\\p{L}\\p{M}'-]/gu, '');\n\nreturn {\n  json: {\n    eventId: event.id,\n    paymentIntentId: paymentIntent.id,\n    checkoutSessionId: session?.id ?? '',\n    email: (session?.customer_details?.email ?? paymentIntent.metadata?.email ?? '').trim().toLowerCase(),\n    name,\n    greeting: firstName ? `Salut ${firstName},` : 'Salut,',\n    amountCents: paymentIntent.amount_received,\n    currency: paymentIntent.currency,\n  },\n};"
      },
      "id": "30a9c934-ff96-474d-8b1f-4b0615baf36a",
      "name": "Prepare buyer",
      "type": "n8n-nodes-base.code",
