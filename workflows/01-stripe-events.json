    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH t AS MATERIALIZED (\n  SELECT replace(gen_random_uuid()::text || gen_random_uuid()::text, '-', '') AS token\n)\nINSERT INTO buyers (stripe_payment_intent_id, stripe_checkout_session_id, stripe_event_id, product_slug, email, name, amount_cents, currency, claim_token_hash)\nSELECT $1, NULLIF($2, ''), $3, $4, $5, NULLIF($6, ''), $7, $8, encode(sha256(convert_to(t.token, 'UTF8')), 'hex')\nFROM t\nON CONFLICT (stripe_payment_intent_id) DO NOTHING\nRETURNING id, (SELECT token FROM t) AS claim_token;",
        "options": {
          "queryReplacement": "={{ [ $json.paymentIntentId, $json.checkoutSessionId, $json.eventId, $('Config').first().json.productSlug, $json.email, $json.name, $json.amountCents, $json.currency ] }}"
        }
      },
